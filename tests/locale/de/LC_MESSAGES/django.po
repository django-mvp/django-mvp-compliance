# Test-only German catalog for the publication email. It is not shipped with the
# package, which carries English only; it lets a test prove the email's strings
# are translatable. Compile after editing:
#
#     msgfmt -o tests/locale/de/LC_MESSAGES/django.mo tests/locale/de/LC_MESSAGES/django.po
msgid ""
msgstr ""
"Project-Id-Version: django-mvp-compliance tests\n"
"Language: de\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "%(name)s: version %(number)s is now in force"
msgstr "%(name)s: Version %(number)s ist jetzt in Kraft"

msgid "Version %(number)s of \"%(name)s\" is now in force."
msgstr "Version %(number)s von \"%(name)s\" ist jetzt in Kraft."

msgid "Published by"
msgstr "Veröffentlicht von"

msgid "Published at"
msgstr "Veröffentlicht am"

msgid "It replaces version %(number)s."
msgstr "Sie ersetzt Version %(number)s."

msgid "This is the first version of the document in force."
msgstr "Dies ist die erste in Kraft gesetzte Version des Dokuments."

msgid "See it in the admin"
msgstr "Im Admin ansehen"
