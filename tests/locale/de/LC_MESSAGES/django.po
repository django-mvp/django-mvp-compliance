# Test-only German catalog for the publication email. It is not shipped with the
# package, which carries English only; it lets a test prove the email's strings
# are translatable. Compile after editing:
#
#     msgfmt -o tests/locale/de/LC_MESSAGES/django.mo tests/locale/de/LC_MESSAGES/django.po
msgid ""
msgstr ""
"Project-Id-Version: django-mvp-compliance tests\n"
"Language: de\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "%(name)s: version %(number)s is now in force"
msgstr "%(name)s: Version %(number)s ist jetzt in Kraft"

msgid "Version %(number)s of \"%(name)s\" is now in force."
msgstr "Version %(number)s von \"%(name)s\" ist jetzt in Kraft."

msgid "Published by"
msgstr "Veröffentlicht von"

msgid "Published at"
msgstr "Veröffentlicht am"

msgid "It replaces version %(number)s."
msgstr "Sie ersetzt Version %(number)s."

msgid "This is the first version of the document in force."
msgstr "Dies ist die erste in Kraft gesetzte Version des Dokuments."

msgid "See it in the admin"
msgstr "Im Admin ansehen"

#, python-format
msgid ""
"This version has been replaced. It was in force from %(published)s to "
"%(replaced)s."
msgstr ""
"Diese Version wurde ersetzt. Sie war vom %(published)s bis zum "
"%(replaced)s in Kraft."

msgid "Title"
msgstr "Titel"

#, python-format
msgid "%(name)s has changed"
msgstr "%(name)s wurde geändert"

#, python-format
msgid "%(name)s is published"
msgstr "%(name)s ist veröffentlicht"

#, python-format
msgid "A new version of %(name)s applies from %(date)s."
msgstr "Eine neue Fassung von %(name)s gilt ab %(date)s."

#, python-format
msgid "%(name)s is published and applies from %(date)s."
msgstr "%(name)s ist veröffentlicht und gilt ab %(date)s."

msgid "What changed"
msgstr "Was sich geändert hat"

msgid "Read it"
msgstr "Lesen"

#, python-format
msgid "Compare it with version %(number)s"
msgstr "Mit Version %(number)s vergleichen"
